ANTHROPIC_API_KEY=
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1
AI_MODEL=claude-haiku-4-5
# Purchase dates for the 12-month CGT date (docs/flex-query.md); the token is a secret
IB_FLEX_TOKEN=
IB_FLEX_QUERY_ID=
# Trading (Milestone 6): the largest order allowed, in the account's base currency
MAX_ORDER_VALUE=10000
# Risk analysis (Milestone 8): what cash earns in a year, for the Sharpe ratio (RBA cash rate)
RISK_FREE_RATE=0.046
# Index members (Milestone 9): set to 1 to let the backend load them in the background (about 20
# minutes of Yahoo calls). Off by default until a screen uses them.
INDEX_LOADER=
