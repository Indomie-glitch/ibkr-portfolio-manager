ANTHROPIC_API_KEY=
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1
AI_MODEL=claude-haiku-4-5
# Purchase dates for the 12-month CGT date (docs/flex-query.md); the token is a secret
IB_FLEX_TOKEN=
IB_FLEX_QUERY_ID=
# Trading (Milestone 6): the largest order allowed, in the account's base currency
MAX_ORDER_VALUE=10000
# Risk analysis (Milestone 8): what cash earns in a year, for the Sharpe ratio (RBA cash rate)
RISK_FREE_RATE=0.046
# Index members (Milestone 9): refreshed in the background, on by default (the bundled copy means
# it only tops up). Set to 0 to turn it off.
INDEX_LOADER=
# Boards of directors (#113): SEC requires a contact email in every EDGAR request. Put your own here;
# the Mac app's build bundles it (backend/write_app_config.py, gitignored app_config.json)
SEC_CONTACT_EMAIL=

# Optional: OpenFIGI key for matching company names to tickers (supply chain pipeline). Free; without one, 25 searches a minute
OPENFIGI_API_KEY=
# Supply chain pipeline (Milestone 10): 1 starts its background workers with the app (they download filings and spend
# AI budget, so off by default); PIPELINE_WORKERS is how many run side by side (default 2).
PIPELINE=
PIPELINE_WORKERS=
