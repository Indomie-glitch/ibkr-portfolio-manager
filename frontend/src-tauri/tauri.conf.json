{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Portfolio Manager",
  "version": "../package.json",
  "identifier": "com.indomieglitch.portfoliomanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Finance",
    "shortDescription": "Interactive Brokers portfolio dashboard",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzQjQwQjhGMUJBQzlDMTIKUldRU25Ld2Jqd3UwbzZBaWxsendYdkFKTkxKc2EwUHBWM3NXbWNaa2RuV3BXRE1MVVdhOGduemkK",
      "endpoints": [
        "https://github.com/Indomie-glitch/ibkr-portfolio-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
